+  def icbm_button_command(self, request_id, button):
+    """Submit one versioned PQ ICBM request; retries with the same ID are idempotent."""
+    if isinstance(request_id, bool) or not isinstance(request_id, int) or not 1 <= request_id <= 0xffff:
+      raise ValueError("request_id must be an integer in 1..65535")
+    if button not in self.ICBM_BUTTONS:
+      raise ValueError("button must be UP, DOWN, SET, or RES")
+    self._handle.controlWrite(Panda.REQUEST_OUT, 0xa9, request_id, self.ICBM_BUTTONS[button], b'')
+
+  def icbm_button_status(self):
+    """Read the fixed-size Panda 10.2 ICBM lifecycle record, or None if unsupported."""
+    raw = self._handle.controlRead(Panda.REQUEST_IN, 0xaa, 0, 0, self.ICBM_STATUS_STRUCT.size)
+    if len(raw) != self.ICBM_STATUS_STRUCT.size:
+      return None
+    version, state, button, reason, request_id, tx_counter = self.ICBM_STATUS_STRUCT.unpack(raw)
+    if version != 1 or state not in self.ICBM_STATES.values() or button > len(self.ICBM_BUTTONS):
+      return None
+    return {"version": version, "state": state, "button": button, "reason": reason,
+            "request_id": request_id, "tx_counter": tx_counter}
+
   def set_obd(self, obd):
     self._handle.controlWrite(Panda.REQUEST_OUT, 0xdb, int(obd), 0, b'')
 
