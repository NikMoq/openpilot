FROM python:3.12-slim

# Standard SDKs/dependencies only. Application sources arrive via a read-only
# bind mount; native modules are regenerated from that checkout in /tmp.
RUN apt-get update && apt-get install -y --no-install-recommends \
      g++ clang libzmq3-dev libeigen3-dev capnproto libcapnp-dev && \
    rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir \
    pytest==8.4.1 numpy==2.3.2 pycapnp==2.0.0 pyzmq==27.0.2 \
    requests==2.32.5 pycryptodome==3.23.0 Cython==3.1.2 setuptools==84.2.1 \
    pytest-mock==3.17.0 parameterized==0.9.0 casadi==3.8.2 scipy==1.18.1 \
    psutil==7.2.2 setproctitle==1.3.8 sentry-sdk==2.73.0 smbus2==0.6.1 \
    Jinja2==3.1.6 PyYAML==6.0.3 PyJWT==2.15.1 pydantic==2.14.2 \
    tqdm==4.70.1 crcmod==1.7 ruamel.yaml==0.19.1 zstandard==0.25.0
ENV PYTHONDONTWRITEBYTECODE=1
